<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Runner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_200</item>
        <item name="colorOnPrimaryContainer">@color/blue_900</item>
        <item name="colorSecondary">@color/ios_indigo</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/ios_gray5</item>
        <item name="colorOnSecondaryContainer">@color/ios_label</item>
        <item name="colorTertiary">@color/ios_orange</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="colorTertiaryContainer">@color/ios_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ios_on_tertiary_container</item>
        <item name="colorError">@color/ios_red</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/ios_error_container</item>
        <item name="colorOnErrorContainer">@color/ios_on_error_container</item>

        <item name="android:colorBackground">@color/ios_grouped_background</item>
        <item name="colorOnBackground">@color/ios_label</item>
        <item name="colorSurface">@color/ios_secondary_grouped_background</item>
        <item name="colorOnSurface">@color/ios_label</item>
        <item name="colorSurfaceVariant">@color/ios_gray5</item>
        <item name="colorOnSurfaceVariant">@color/ios_gray</item>
        <item name="colorSurfaceContainerLowest">@color/black</item>
        <item name="colorSurfaceContainerLow">@color/ios_gray6</item>
        <item name="colorSurfaceContainer">@color/ios_gray6</item>
        <item name="colorSurfaceContainerHigh">@color/ios_gray5</item>
        <item name="colorSurfaceContainerHighest">@color/ios_gray4</item>
        <item name="colorOutline">@color/ios_opaque_separator</item>
        <item name="colorOutlineVariant">@color/ios_gray5</item>

        <item name="android:statusBarColor">@color/ios_grouped_background</item>
        <item name="android:navigationBarColor">@color/ios_grouped_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Runner.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Runner.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Runner.LargeComponent</item>

        <item name="materialButtonStyle">@style/Widget.Runner.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Runner.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Runner.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.Runner.Card</item>
        <item name="floatingActionButtonStyle">@style/Widget.Runner.Fab</item>
        <item name="navigationViewStyle">@style/Widget.Runner.NavigationView</item>
        <item name="toolbarStyle">@style/Widget.Runner.Toolbar</item>
        <item name="textInputStyle">@style/Widget.Runner.TextInput</item>
        <item name="switchStyle">@style/Widget.Runner.Switch</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Runner.MaterialAlertDialog</item>
        <item name="snackbarStyle">@style/Widget.Runner.Snackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.Runner.Snackbar.Button</item>
    </style>

    <style name="Theme.Runner.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/ios_blue</item>
        <item name="android:textColorPrimary">@color/ios_label</item>
    </style>

    <style name="Theme.Runner.PopupOverlay" parent="ThemeOverlay.Material3.Dark" />
</resources>
