<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    app:tint="?attr/colorOnSurface">
    
    <!-- Фигура бегуна -->
    <group>
        <!-- Голова -->
        <circle
            android:fillColor="@android:color/black"
            android:centerX="12"
            android:centerY="4"
            android:radius="1.5dp" />
        
        <!-- Тело -->
        <path
            android:fillColor="@android:color/black"
            android:pathData="M12,5.5 L12,14" 
            android:strokeWidth="1.5"
            android:strokeColor="@android:color/black"
            android:strokeLineCap="round" />
        
        <!-- Левая рука (поднята) -->
        <path
            android:fillColor="@android:color/black"
            android:pathData="M12,7 L9,3" 
            android:strokeWidth="1.5"
            android:strokeColor="@android:color/black"
            android:strokeLineCap="round" />
        
        <!-- Правая рука (опущена) -->
        <path
            android:fillColor="@android:color/black"
            android:pathData="M12,7 L15,11" 
            android:strokeWidth="1.5"
            android:strokeColor="@android:color/black"
            android:strokeLineCap="round" />
        
        <!-- Левая нога (вытянута) -->
        <path
            android:fillColor="@android:color/black"
            android:pathData="M12,14 L8,20" 
            android:strokeWidth="1.5"
            android:strokeColor="@android:color/black"
            android:strokeLineCap="round" />
        
        <!-- Правая нога (поджата) -->
        <path
            android:fillColor="@android:color/black"
            android:pathData="M12,14 L16,18" 
            android:strokeWidth="1.5"
            android:strokeColor="@android:color/black"
            android:strokeLineCap="round" />
        
        <!-- Дорожка -->
        <path
            android:fillColor="@android:color/black"
            android:pathData="M4,20 Q12,18 20,20" 
            android:strokeWidth="1"
            android:strokeColor="@android:color/black"
            android:strokeLineCap="round" />
    </group>
</vector>
