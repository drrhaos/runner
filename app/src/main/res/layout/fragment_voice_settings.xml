<?xml version="1.0" encoding="utf-8"?>
<!-- Voice coaching: every change is written to the preferences at once, the service reads them
     on its tick. Section titles are accessibilityHeading from code (the attribute is API 28). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.settings.VoiceSettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Главный переключатель -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp">

                <include
                    android:id="@+id/row_voice_enabled"
                    layout="@layout/layout_voice_switch_row" />

                <TextView
                    android:id="@+id/textView_voice_status_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_status_note"
                    android:textAppearance="@style/TextAppearance.Runner.Footnote"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Бег без отрезков -->
        <TextView
            android:id="@+id/textView_section_free"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/voice_profile_free"
            style="@style/RunnerSectionHeader" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <include
                    android:id="@+id/row_free_summary"
                    layout="@layout/layout_voice_choice_row" />

                <include
                    android:id="@+id/row_free_metrics"
                    layout="@layout/layout_voice_metrics_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Интервалы -->
        <TextView
            android:id="@+id/textView_section_intervals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/voice_profile_intervals"
            style="@style/RunnerSectionHeader" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/voice_profile_intervals_hint"
            android:textAppearance="@style/TextAppearance.Runner.Footnote"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <include
                    android:id="@+id/row_intervals_summary"
                    layout="@layout/layout_voice_choice_row" />

                <include
                    android:id="@+id/row_intervals_metrics"
                    layout="@layout/layout_voice_metrics_row" />

                <include
                    android:id="@+id/row_intervals_segment_change"
                    layout="@layout/layout_voice_switch_row" />

                <include
                    android:id="@+id/row_intervals_target_check"
                    layout="@layout/layout_voice_switch_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Цель отрезка: не зависит от главного переключателя (полоса отрезков работает без голоса) -->
        <TextView
            android:id="@+id/textView_section_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/voice_target_section"
            style="@style/RunnerSectionHeader" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <include
                    android:id="@+id/row_pace_tolerance"
                    layout="@layout/layout_voice_choice_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Мили: голос всё равно в километрах -->
        <TextView
            android:id="@+id/textView_units_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/voice_metric_units_note"
            android:textAppearance="@style/TextAppearance.Runner.Footnote"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
