<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.devices.DevicesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Секция «Пульсометр» (заголовок: accessibilityHeading из кода, атрибут с API 28) -->
        <TextView
            android:id="@+id/textView_section_heart_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/devices_section_heart_rate"
            style="@style/RunnerSectionHeader" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Привязанное устройство: одна группа для TalkBack, кнопки фокусируются отдельно -->
                <LinearLayout
                    android:id="@+id/layout_device_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sensor_heart_rate"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView_device_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Runner.Headline"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="HR Strap 10 1234ABCD" />

                        <!-- Статус объявляется при смене связи; пульс рядом — без liveRegion -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textView_device_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="polite"
                                android:textAppearance="@style/TextAppearance.Runner.Subhead"
                                tools:text="@string/devices_status_connected" />

                            <TextView
                                android:id="@+id/textView_device_bpm"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.Runner.Subhead"
                                android:visibility="gone"
                                tools:text="· 142 bpm"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textView_device_meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Runner.Caption"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="battery 80%" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_device_action"
                            style="@style/Widget.Runner.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            tools:text="@string/devices_enable_bluetooth"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/button_device_menu"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/devices_menu_forget"
                        android:src="@drawable/ic_more_vert"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Пустое состояние -->
                <LinearLayout
                    android:id="@+id/layout_devices_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:alpha="0.4"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sensor_heart_rate"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:text="@string/devices_empty_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textAppearance="@style/TextAppearance.Runner.Title3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_horizontal"
                        android:text="@string/devices_empty_message"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textAppearance="@style/TextAppearance.Runner.Subhead" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_devices_add"
                        style="@style/Widget.Runner.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/devices_add" />

                    <TextView
                        android:id="@+id/textView_devices_ble_unsupported"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_horizontal"
                        android:text="@string/devices_ble_unsupported"
                        android:textColor="?attr/colorError"
                        android:textAppearance="@style/TextAppearance.Runner.Subhead"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
