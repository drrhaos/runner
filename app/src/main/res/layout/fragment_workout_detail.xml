<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.workout.WorkoutDetailFragment">

    <!-- Карта с маршрутом -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true" />

        <!-- Индикатор загрузки маршрута -->
        <ProgressBar
            android:id="@+id/progressBar_map_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible"
            style="?android:attr/progressBarStyleLarge" />

    </FrameLayout>

    <!-- Переключатель режимов -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroup_analysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_basic_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workout_details_basic_params"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_charts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workout_details_charts"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </com.google.android.material.card.MaterialCardView>

    <!-- ScrollView для графиков и информации -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    <!-- Контейнер для основных параметров -->
    <LinearLayout
        android:id="@+id/layout_basic_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Рекорды тренировки: поздравление сразу после сохранения, иначе отметка -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_records"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorTertiaryContainer"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/imageView_records_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_menu_records"
                app:tint="?attr/colorOnTertiaryContainer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView_records_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    tools:text="@string/records_congrats_title" />

                <LinearLayout
                    android:id="@+id/layout_records_lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/textView_records_steps_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/records_steps_note"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_records_open_all"
                    style="@style/Widget.Runner.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/records_open_all"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="textEnd"
                    app:iconTint="@color/ios_blue" />
            </LinearLayout>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Панель с информацией о тренировке -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Заголовок с датой и типом -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView_detail_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="01.01.2024"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/textView_detail_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="14:30"
                        android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/button_favorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/workout_favorite_add"
                    android:padding="8dp"
                    android:src="@drawable/ic_star_border"
                    tools:src="@drawable/ic_star" />

                <TextView
                    android:id="@+id/textView_detail_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/workout_type_easy_run"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnPrimary"
                    android:background="@drawable/type_chip_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- Основная статистика -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Дистанция -->
                <LinearLayout
                    android:id="@+id/layout_detail_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/textView_detail_distance"
                        style="@style/RunnerDetailMetricValue"
                        tools:text="5.0 км" />

                    <TextView
                        style="@style/RunnerDetailMetricCaption"
                        android:text="@string/workout_distance_label" />
                </LinearLayout>

                <!-- Время -->
                <LinearLayout
                    android:id="@+id/layout_detail_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/textView_detail_duration"
                        style="@style/RunnerDetailMetricValue"
                        android:text="@string/track_info_time_placeholder"
                        tools:text="25:30" />

                    <TextView
                        android:id="@+id/textView_detail_duration_label"
                        style="@style/RunnerDetailMetricCaption"
                        android:text="@string/workout_time_label" />
                </LinearLayout>

                <!-- Средний темп -->
                <LinearLayout
                    android:id="@+id/layout_detail_pace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/textView_detail_pace"
                        style="@style/RunnerDetailMetricValue"
                        tools:text="5:06" />

                    <TextView
                        style="@style/RunnerDetailMetricCaption"
                        android:text="@string/workout_pace_label_km" />
                </LinearLayout>
            </LinearLayout>

            <!-- Дополнительная статистика -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Средняя скорость -->
                <LinearLayout
                    android:id="@+id/layout_detail_avg_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/textView_detail_avg_speed"
                        style="@style/RunnerDetailMetricValue.Secondary"
                        tools:text="11.8 км/ч" />

                    <TextView
                        style="@style/RunnerDetailMetricCaption"
                        android:text="@string/workout_details_average_speed" />
                </LinearLayout>

                <!-- Калории -->
                <LinearLayout
                    android:id="@+id/layout_detail_calories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/textView_detail_calories"
                        style="@style/RunnerDetailMetricValue.Secondary"
                        tools:text="300 ккал" />

                    <TextView
                        style="@style/RunnerDetailMetricCaption"
                        android:text="@string/workout_details_calories" />
                </LinearLayout>

                <!-- Каденс: скрыт, когда шагов нет -->
                <LinearLayout
                    android:id="@+id/layout_detail_cadence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/textView_detail_cadence"
                        style="@style/RunnerDetailMetricValue.Secondary"
                        tools:text="172" />

                    <TextView
                        style="@style/RunnerDetailMetricCaption"
                        android:text="@string/workout_details_cadence" />
                </LinearLayout>
            </LinearLayout>

            <!-- Третий ряд: набор и сброс высоты (когда в треке есть высоты) и общее время
                 (когда оно отличается от времени в движении) -->
            <LinearLayout
                android:id="@+id/layout_detail_third_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:weightSum="3"
                android:baselineAligned="false"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Набор высоты -->
                <LinearLayout
                    android:id="@+id/layout_detail_elevation_gain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/textView_detail_elevation_gain"
                        style="@style/RunnerDetailMetricValue.Secondary"
                        tools:text="↑ 124 м" />

                    <TextView
                        style="@style/RunnerDetailMetricCaption"
                        android:text="@string/workout_elevation_gain_label" />
                </LinearLayout>

                <!-- Сброс высоты -->
                <LinearLayout
                    android:id="@+id/layout_detail_elevation_loss"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/textView_detail_elevation_loss"
                        style="@style/RunnerDetailMetricValue.Secondary"
                        tools:text="↓ 118 м" />

                    <TextView
                        style="@style/RunnerDetailMetricCaption"
                        android:text="@string/workout_elevation_loss_label" />
                </LinearLayout>

                <!-- Общее время -->
                <LinearLayout
                    android:id="@+id/layout_detail_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/textView_detail_elapsed"
                        style="@style/RunnerDetailMetricValue.Secondary"
                        tools:text="28:40" />

                    <TextView
                        style="@style/RunnerDetailMetricCaption"
                        android:text="@string/workout_elapsed_time_label" />
                </LinearLayout>
            </LinearLayout>

            <!-- Пометка источника высоты (GPS, файл): открывает пояснение -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_elevation_source_note"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:letterSpacing="0"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:icon="@drawable/ic_info_outline"
                app:iconSize="16dp"
                app:iconPadding="6dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="@string/workout_elevation_source_gps"
                tools:visibility="visible" />

            <!-- Не учитывать в рекордах: строка читается одной группой, нажатие переключает свитч -->
            <LinearLayout
                android:id="@+id/row_exclude_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/textView_exclude_records_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/records_exclude_label"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_exclude_records"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:saveEnabled="false"
                    tools:checked="false" />

            </LinearLayout>

            <!-- Почему тренировка не учитывается в рекордах сама по себе -->
            <TextView
                android:id="@+id/textView_records_auto_excluded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:drawablePadding="6dp"
                android:text="@string/records_auto_excluded"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ic_info_outline_small"
                app:drawableTint="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Кнопки действий -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_share"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:padding="2dp"
                        android:text="@string/workout_details_btn_share"
                        android:drawableStart="@android:drawable/ic_menu_share"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_export_gpx"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="2dp"
                        android:text="@string/workout_details_btn_export_gpx"
                        android:drawableStart="@android:drawable/ic_menu_upload"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_share_diagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/workout_details_btn_share_diagnostics"
                    android:drawableStart="@android:drawable/ic_menu_share"
                    android:visibility="gone"
                    tools:visibility="visible"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/edit"
                    android:drawableStart="@android:drawable/ic_menu_edit"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_delete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/workout_details_btn_delete"
                    android:drawableStart="@android:drawable/ic_menu_delete"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="?attr/colorOnError"
                    app:backgroundTint="?attr/colorError" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Контейнер для графиков -->
    <LinearLayout
        android:id="@+id/layout_charts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

    <!-- График темпа/скорости/пульса -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/workout_details_pace_speed_pulse_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_pace_speed_heart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    />

                <TextView
                    android:id="@+id/textView_chart_pace_speed_heart_values"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@color/panel_surface_color"
                    android:padding="8dp"
                    android:gravity="start"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- График каденса: скрыт целиком, когда каденса в точках нет -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_chart_cadence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/workout_details_cadence_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/textView_chart_cadence_avg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="ср. 172 шаг/мин"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_cadence"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/textView_chart_cadence_values"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@color/panel_surface_color"
                    android:padding="8dp"
                    android:gravity="start"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- График высоты: скрыт целиком, когда высот в точках нет -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_chart_elevation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/workout_details_height_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/textView_elevation_chart_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="↑ 124 м  ↓ 118 м"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <TextView
                android:id="@+id/textView_elevation_chart_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/workout_elevation_source_gps_short"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_elevation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/textView_chart_elevation_values"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@color/panel_surface_color"
                    android:padding="8dp"
                    android:gravity="start"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- График темпа/скорости по сегментам -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/workout_details_pace_speed_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroup_segment_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:singleSelection="true"
                    app:checkedChip="@+id/chip_pace">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_pace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/workout_details_pace"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/workout_details_speed"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chart_segments"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/textView_chart_segments_values"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@color/panel_surface_color"
                    android:padding="8dp"
                    android:gravity="start"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>