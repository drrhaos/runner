<?xml version="1.0" encoding="utf-8"?>
<!-- Один шаг за раз: видна одна группа. Заголовки шагов — accessibilityHeading из кода (атрибут с API 28) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.devices.AddSensorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Разрешение / геолокация -->
        <LinearLayout
            android:id="@+id/group_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textView_permission_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Runner.Body"
                android:textColor="?attr/colorOnSurface"
                tools:text="@string/add_sensor_permission_rationale_31" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_permission"
                style="@style/Widget.Runner.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                tools:text="@string/devices_allow" />
        </LinearLayout>

        <!-- 2–4. Скан, список, подсказки, повтор -->
        <LinearLayout
            android:id="@+id/group_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/layout_scan_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_scan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/textView_scanning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/add_sensor_scanning"
                    android:textAppearance="@style/TextAppearance.Runner.Headline"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/textView_seconds_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Runner.Caption"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="12 s left" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView_found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_found_sensor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_not_found"
                style="@style/Widget.Runner.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/add_sensor_not_found_link"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/group_hints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/textView_hints_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_sensor_empty_title"
                    android:textAppearance="@style/TextAppearance.Runner.Headline"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/add_sensor_hint_strap"
                    android:textAppearance="@style/TextAppearance.Runner.Subhead"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/add_sensor_hint_single_connection"
                    android:textAppearance="@style/TextAppearance.Runner.Subhead"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/add_sensor_hint_watch_broadcast"
                    android:textAppearance="@style/TextAppearance.Runner.Subhead"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/add_sensor_hint_no_broadcast"
                    android:textAppearance="@style/TextAppearance.Runner.Subhead"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_scan_again"
                style="@style/Widget.Runner.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/add_sensor_scan_again"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 6. Проверка -->
        <LinearLayout
            android:id="@+id/group_probing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_probe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/textView_probing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:textAppearance="@style/TextAppearance.Runner.Headline"
                android:textColor="?attr/colorOnSurface"
                tools:text="Checking HR Strap 10…" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/add_sensor_probing_hint"
                android:textAppearance="@style/TextAppearance.Runner.Subhead"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_probe_cancel"
                style="@style/Widget.Runner.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cancel" />
        </LinearLayout>

        <!-- 7. Ошибки скана и проверки -->
        <LinearLayout
            android:id="@+id/group_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textView_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Runner.Body"
                android:textColor="?attr/colorError"
                tools:text="@string/add_sensor_error_bluetooth_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_error_enable"
                style="@style/Widget.Runner.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/devices_enable_bluetooth"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_error_retry"
                style="@style/Widget.Runner.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/add_sensor_retry"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_error_back"
                style="@style/Widget.Runner.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/add_sensor_back_to_list"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
