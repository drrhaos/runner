<?xml version="1.0" encoding="utf-8"?>
<!-- A choice row of the voice screen: one group for TalkBack, a tap opens a single-choice dialog.
     The value is capped at half the row from code; both texts wrap at 200 % font. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/textView_choice_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        tools:text="@string/voice_summary_label" />

    <TextView
        android:id="@+id/textView_choice_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:gravity="end"
        android:textSize="16sp"
        android:textColor="?attr/colorPrimary"
        tools:text="@string/voice_every_km_1" />

</LinearLayout>
