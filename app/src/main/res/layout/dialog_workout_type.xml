<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_choose_workout_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="16dp" />

<!-- TODO: color gradiend backgroung for each type -->
    <RadioGroup
        android:id="@+id/radioGroup_workout_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radio_easy_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workout_type_easy_run"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/radio_tempo_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workout_type_tempo_run"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/radio_interval_training"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workout_type_interval_training"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/radio_long_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workout_type_long_run"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/radio_recovery_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workout_type_recovery_run"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/radio_race"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workout_type_competition" />

    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dialog_start_workout"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</LinearLayout>
