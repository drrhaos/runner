<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/textView_import_conflict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Imported — run.tcx\n14.05.2018 12:12 · 7.30 km · 37:14 · no track\n\nOverlaps with\n14.05.2018 12:12 · 7.25 km · 37:10 · with track (already in the app)" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_import_conflict_skip"
                style="@style/Widget.Runner.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workout_import_conflict_skip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_import_conflict_keep_both"
                style="@style/Widget.Runner.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workout_import_conflict_keep_both" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_import_conflict_replace"
                style="@style/Widget.Runner.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workout_import_conflict_replace" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
