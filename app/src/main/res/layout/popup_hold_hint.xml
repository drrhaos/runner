<?xml version="1.0" encoding="utf-8"?>
<!-- The touch-and-hold hint of a settings row (HoldHints): a card as wide as the screen minus the
     margins, no line limit. The margins also leave room for the shadow inside the window. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/text_hold_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textAppearance="@style/TextAppearance.Runner.Subhead"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/colorOnSurface"
            tools:text="@string/settings_hint_auto_pause" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
