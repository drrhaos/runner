<?xml version="1.0" encoding="utf-8"?>
<!-- "What to say": the chosen metrics under the label, and a note when heart rate has no monitor.
     One group for TalkBack, a tap opens the multi-choice dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voice_metrics_label"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/textView_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="distance, time, average pace" />

    <TextView
        android:id="@+id/textView_hr_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voice_metrics_hr_no_sensor"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
